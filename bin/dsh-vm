#!/usr/bin/env bash
# dsh-vm: run a dsh handoff inside a microVM, on a throwaway clone of the repo.
#
#   dsh-vm run "<prompt>"   clone the repo (plus .handoff/) and run dsh in a VM; prints the run dir
#   dsh-vm apply <run-dir>  copy the run's changes into the repo as uncommitted changes
#   dsh-vm clean <run-dir>  delete a run (or --all)
#   dsh-vm list             list runs
#   dsh-vm log [run-dir]    follow a run's log live (default: the newest run); Ctrl+C stops watching
#   dsh-vm build            (re)build the image, e.g. after editing image/ or to update dsh
#
# Inside the VM dsh has full access (no sandbox, no approvals). The VM only sees the clone,
# the API key and the network: no SSH keys, no gh token, no git remote, so it cannot push.
set -euo pipefail

IMAGE=${DSH_VM_IMAGE:-localhost/dsh-vm:latest}
RUNTIME=${DSH_VM_RUNTIME:-krun}          # set to runc/crun to run as a plain container
MEMORY=${DSH_VM_MEMORY:-2g}
CPUS=${DSH_VM_CPUS:-2}
TIMEOUT_MIN=${DSH_VM_TIMEOUT_MIN:-90}    # the VM is killed after this many minutes
RUNS=${DSH_VM_RUNS:-${XDG_CACHE_HOME:-$HOME/.cache}/dsh-vm/runs}
# npm's download cache, kept between runs so `npm ci` doesn't fetch everything again. npm checks
# every package's hash, so one run can't poison it for the next.
NPM_CACHE=${DSH_VM_NPM_CACHE:-dsh-vm-npm}
# ~/.cache, kept between runs so Playwright/Puppeteer browsers (~700 MB) and corepack's pnpm/yarn
# download once per version. A run could tamper with it, but the next run gets nothing the
# earlier one didn't already have (the same key and network).
HOME_CACHE=${DSH_VM_CACHE:-dsh-vm-cache}

die() { echo "dsh-vm: $*" >&2; exit 1; }

# A run dir must sit directly inside $RUNS, so apply/clean never touch anything else.
run_dir() {
  local dir
  dir=$(realpath -e -- "${1:?run dir required}") || die "no such run: $1"
  [[ $(dirname -- "$dir") == "$(realpath -m -- "$RUNS")" ]] || die "not a run dir under $RUNS: $1"
  printf '%s\n' "$dir"
}

cmd_run() {
  local prompt=${1:?prompt required}
  [[ -n ${DEEPSEEK_API_KEY:-} ]] || die "DEEPSEEK_API_KEY is not set"
  local repo; repo=$(git rev-parse --show-toplevel) || die "not in a git repo"
  [[ -f $repo/.handoff/plan.md ]] || die "$repo/.handoff/plan.md not found"

  local dir; dir="$RUNS/$(basename -- "$repo")-$(date +%Y%m%d-%H%M%S)"
  mkdir -p -- "$RUNS"
  # --no-hardlinks: the VM must not be able to reach the repo's object files.
  git clone -q --no-hardlinks -- "$repo" "$dir"
  git -C "$dir" remote remove origin
  cp -a -- "$repo/.handoff/." "$dir/.handoff/"
  rm -f -- "$dir/.handoff/report.md" "$dir/.handoff/last-run.log"

  echo "$dir"
  local status=0 started=$SECONDS
  podman run --rm --runtime "$RUNTIME" --memory "$MEMORY" --cpus "$CPUS" \
    --timeout "$((TIMEOUT_MIN * 60))" --name "dsh-vm-$(basename -- "$dir")" \
    -e DEEPSEEK_API_KEY -v "$dir:/work:Z" -v "$NPM_CACHE:/root/.npm" -v "$HOME_CACHE:/root/.cache" -w /work "$IMAGE" \
    no-ipv6 dsh --profile headless --permission-mode danger-full-access "$prompt" \
    >"$dir/.handoff/last-run.log" 2>&1 || status=$?
  if (( status != 0 && SECONDS - started >= TIMEOUT_MIN * 60 )); then
    echo "dsh-vm: timed out after $TIMEOUT_MIN minutes; the VM was stopped" \
      | tee -a "$dir/.handoff/last-run.log"
  fi
  echo "dsh-vm: exited $status; log in $dir/.handoff/last-run.log"
  return "$status"
}

cmd_apply() {
  local dir; dir=$(run_dir "${1:-}")
  local repo; repo=$(git rev-parse --show-toplevel) || die "not in a git repo"
  [[ $(git -C "$dir" rev-parse HEAD) == $(git -C "$repo" rev-parse HEAD) ]] \
    || die "repo HEAD moved since the run; apply by hand"
  [[ -z $(git -C "$repo" status --porcelain -- . ':(exclude).handoff') ]] \
    || die "repo has uncommitted changes; commit or stash first"
  # Stage everything in the clone (respecting .gitignore) and replay it as unstaged changes;
  # new files land untracked, as if dsh had run in the repo itself.
  git -C "$dir" add -A
  git -C "$dir" diff --cached --binary HEAD -- . ':(exclude).handoff' | git -C "$repo" apply --allow-empty
  for f in report.md last-run.log; do
    [[ -f $dir/.handoff/$f ]] && cp -- "$dir/.handoff/$f" "$repo/.handoff/$f"
  done
  git -C "$repo" status --short
}

cmd_clean() {
  if [[ ${1:-} == --all ]]; then
    rm -rf -- "${RUNS:?}"/*
  else
    rm -rf -- "$(run_dir "${1:-}")"
  fi
}

cmd_list() { ls -1 -- "$RUNS" 2>/dev/null || true; }

cmd_log() {
  local dir
  if [[ -n ${1:-} ]]; then
    dir=$(run_dir "$1")
  else
    dir=$(ls -1td -- "$RUNS"/*/ 2>/dev/null | head -1) || true
    [[ -n $dir ]] || die "no runs in $RUNS"
    dir=${dir%/}
  fi
  echo "== $dir/.handoff/last-run.log (Ctrl+C stops watching; the run keeps going)" >&2
  tail -n +1 -F -- "$dir/.handoff/last-run.log"
}

cmd_build() {
  local here; here=$(dirname -- "$(realpath -- "$0")")
  podman build --pull=newer -t "$IMAGE" "$@" "$here/../image" && podman image prune -f >/dev/null
}

case ${1:-} in
  run|apply|clean|list|log|build) cmd=$1; shift; "cmd_$cmd" "$@" ;;
  *) sed -n '2,9s/^# \{0,1\}//p' "$0"; exit 2 ;;
esac
